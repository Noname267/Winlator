<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="6dp"
        android:top="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#141414" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#2B2B2B" />
            <stroke
                android:width="1dp"
                android:color="#424242" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</layer-list>
